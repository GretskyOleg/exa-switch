<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EXA Switch — установка</title>
<style>
  :root {
    --bg:#050304; --card:#12090d; --card2:#1a0c11; --line:#34131a;
    --text:#f7e9ec; --muted:#b18c93; --muted2:#7a575f;
    --red:#ff2338; --red2:#b00018; --green:#2ee6a5; --amber:#ffb020;
    --grad:linear-gradient(135deg,#ff2b41,#b00018);
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;min-height:100vh;color:var(--text);
    font-family:"Inter","Segoe UI",system-ui,-apple-system,sans-serif;font-size:15px;
    background:
      radial-gradient(900px 520px at 88% -10%,rgba(255,35,56,.18),transparent 62%),
      radial-gradient(700px 420px at -10% 10%,rgba(255,35,56,.09),transparent 60%),
      var(--bg);
  }
  body::before{
    content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
    background:repeating-linear-gradient(180deg,rgba(255,255,255,.022) 0 1px,transparent 1px 4px);
    opacity:.55;
  }
  a{color:#ff97a3}
  .wrap{position:relative;z-index:1;max-width:1120px;margin:0 auto;padding:26px 22px 46px}

  .hero{
    position:relative;overflow:hidden;border:1px solid rgba(255,35,56,.25);border-radius:20px;
    min-height:330px;padding:30px 32px;margin-bottom:20px;
    background:
      linear-gradient(90deg,rgba(5,3,4,.98) 0%,rgba(5,3,4,.9) 40%,rgba(5,3,4,.38) 70%,rgba(5,3,4,.9) 100%),
      linear-gradient(180deg,rgba(5,3,4,.1),rgba(5,3,4,.93)),
      url("branding/hero.jpg") center 30% / cover no-repeat;
    box-shadow:0 24px 90px rgba(0,0,0,.55),inset 0 0 120px rgba(255,35,56,.05);
  }
  .hero::after{
    content:"";position:absolute;inset:0;pointer-events:none;
    background:repeating-linear-gradient(180deg,rgba(255,255,255,.024) 0 1px,transparent 1px 4px);
    opacity:.6;
  }
  .hero-main{position:relative;z-index:2;max-width:650px}
  .eyebrow{color:#ff97a3;font-size:10px;letter-spacing:2.6px;text-transform:uppercase;font-weight:800;margin-bottom:16px}
  .eyebrow span{color:var(--red)}
  .logo{width:300px;max-width:72vw;height:auto;display:block;filter:drop-shadow(0 0 28px rgba(255,35,56,.4));margin-bottom:10px}
  h1{margin:0 0 8px;font-size:40px;line-height:1;letter-spacing:1px;text-transform:uppercase;font-weight:900}
  h1 span{color:var(--red)}
  .tagline{color:#e9cfd4;font-size:15px;line-height:1.5;margin:0 0 18px}
  .tagline b{color:#fff;font-weight:700}
  .hero-chips{display:flex;flex-wrap:wrap;gap:8px}
  .chip{
    display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border-radius:999px;
    border:1px solid rgba(255,35,56,.28);background:rgba(12,6,8,.72);
    color:#ffb3bc;font-size:10.5px;font-weight:700;letter-spacing:.9px;text-transform:uppercase;
  }
  .chip .dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px rgba(46,230,165,.8)}
  .chip.dim{color:var(--muted);border-color:var(--line)}
  .portrait{
    position:absolute;z-index:1;right:26px;top:26px;bottom:26px;width:190px;
    border:1px solid rgba(255,35,56,.3);border-radius:14px;overflow:hidden;
    box-shadow:0 0 50px rgba(255,35,56,.14);
  }
  .portrait img{width:100%;height:100%;object-fit:cover;object-position:center 15%;filter:saturate(.92) contrast(1.05)}
  .portrait::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 38%,rgba(5,3,4,.96) 100%)}
  .portrait-label{position:absolute;z-index:2;left:11px;bottom:10px;color:#ffb3bc;font-size:9px;letter-spacing:1.6px;font-weight:800}
  .portrait-label span{color:var(--red)}

  .notice{
    display:flex;gap:12px;align-items:flex-start;border:1px solid rgba(255,176,32,.28);
    background:rgba(255,176,32,.06);color:#ffe0a3;border-radius:14px;padding:13px 15px;
    margin:0 0 20px;font-size:12.5px;line-height:1.5;
  }
  .notice b{color:#fff}
  .notice .ico{color:var(--amber);font-size:16px;line-height:1.2}

  .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px}
  .card{
    border:1px solid var(--line);border-radius:17px;padding:20px;
    background:linear-gradient(180deg,rgba(26,12,17,.86),rgba(10,5,7,.94));
    box-shadow:0 16px 50px rgba(0,0,0,.28);
  }
  .card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px}
  .card h2{margin:0;font-size:18px;letter-spacing:.3px;text-transform:uppercase}
  .card .sub{color:var(--muted2);font-size:12px;margin:0 0 16px}
  .browser{font-size:10px;font-weight:800;letter-spacing:1.1px;text-transform:uppercase;color:var(--red);border:1px solid rgba(255,35,56,.25);padding:4px 8px;border-radius:999px}
  .step{display:grid;grid-template-columns:26px minmax(0,1fr);gap:11px;margin:13px 0}
  .num{
    width:26px;height:26px;border-radius:8px;display:grid;place-items:center;
    background:rgba(255,35,56,.1);border:1px solid rgba(255,35,56,.25);color:#ffb3bc;
    font-size:11px;font-weight:800;
  }
  .step b{display:block;font-size:13px;margin-bottom:3px}
  .step p{margin:0;color:var(--muted);font-size:12.5px;line-height:1.5}
  .pathline{display:flex;gap:7px;align-items:stretch;margin-top:8px}
  .path{
    flex:1;min-width:0;display:block;padding:9px 11px;border-radius:9px;border:1px solid var(--line);
    background:#070406;color:#ffd6dc;font-family:"JetBrains Mono",Consolas,monospace;font-size:11.5px;
    line-height:1.45;word-break:break-all;
  }
  .copy{
    flex:0 0 auto;border:1px solid rgba(255,35,56,.35);background:rgba(255,35,56,.1);
    color:#ffb3bc;border-radius:9px;padding:0 11px;font:inherit;font-size:11px;font-weight:700;cursor:pointer;
  }
  .copy:hover{background:rgba(255,35,56,.18);color:#fff}
  .key{display:inline-block;padding:2px 7px;border-radius:6px;background:rgba(255,35,56,.08);border:1px solid rgba(255,35,56,.18);color:#ffb3bc;font-family:"JetBrains Mono",Consolas,monospace;font-size:11px}
  .hint{margin:14px 0 0;color:var(--muted2);font-size:11.5px;line-height:1.5}

  .wide{grid-column:1/-1}
  .platform{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:6px}
  .mini{border:1px solid var(--line);border-radius:12px;padding:13px;background:rgba(7,4,6,.55)}
  .mini .k{color:var(--muted2);font-size:9.5px;letter-spacing:1.2px;text-transform:uppercase;margin-bottom:5px}
  .mini .v{font-size:12px;color:#f3d9de;word-break:break-all;font-family:"JetBrains Mono",Consolas,monospace}
  .footer{
    display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;
    margin-top:24px;padding-top:16px;border-top:1px solid var(--line);
    color:var(--muted2);font-size:10.5px;letter-spacing:1.4px;text-transform:uppercase;font-weight:700;
  }
  .footer span{color:var(--red)}
  .copy-ok{color:var(--green)!important}

  @media(max-width:860px){
    .grid{grid-template-columns:1fr}
    .portrait{display:none}
    h1{font-size:32px}
    .logo{width:230px}
    .hero{min-height:0;padding:24px}
    .platform{grid-template-columns:1fr}
  }
</style>
</head>
<body>
<div class="wrap">

  <section class="hero">
    <div class="hero-main">
      <div class="eyebrow">EXA <span>//</span> SECURE TUNNEL <span>//</span> SETUP</div>
      <img class="logo" src="branding/logo.png" alt="EXA">
      <h1>EXA <span>Switch</span></h1>
      <p class="tagline"><b>Твой трафик. Твои правила.</b><br>VLESS / Reality / XHTTP — только там, где нужно.</p>
      <div class="hero-chips">
        <span class="chip"><span class="dot"></span> helper установлен</span>
        <span class="chip dim">v{{VERSION}}</span>
        <span class="chip dim">{{PLATFORM}}</span>
      </div>
    </div>
    <div class="portrait">
      <img src="branding/persona.jpg" alt="">
      <div class="portrait-label">EXA <span>//</span> 001</div>
    </div>
  </section>

  <div class="notice">
    <div class="ico">!</div>
    <div>
      <b>Осталось одно действие в браузере.</b> Chrome и Firefox не разрешают установщику молча добавить расширение.
      Всё остальное уже установлено: helper, native messaging, автозапуск и расширения.
      Если расширение уже появилось в браузере — установка завершена. Ниже — ручной fallback и точные пути.
    </div>
  </div>

  <div class="grid">

    <section class="card">
      <div class="card-head">
        <h2>Chrome / Chromium / Edge / Brave</h2>
        <span class="browser">CRX / auto</span>
      </div>
      <p class="sub">Обычно расширение ставится автоматически при следующем запуске браузера (подписанный CRX + external extension). Chrome может показать один запрос подтверждения.</p>

      <div class="step">
        <div class="num">1</div>
        <div>
          <b>Проверь chrome://extensions</b>
          <p>Если <b>EXA Switch</b> уже в списке — всё готово. Если нет — перезапусти браузер.</p>
        </div>
      </div>
      <div class="step">
        <div class="num">2</div>
        <div>
          <b>Ручной fallback: Load unpacked</b>
          <p>Включи <b>Developer mode</b> и выбери папку:</p>
          <div class="pathline">
            <code class="path" id="chromePath">{{CHROME_DIR}}</code>
            <button class="copy" data-copy-target="chromePath">Копировать</button>
          </div>
        </div>
      </div>
      <div class="step">
        <div class="num">3</div>
        <div>
          <b>Готово</b>
          <p>Расширение останется в браузере после перезапуска. ID: <span class="key">{{CHROME_ID}}</span>.</p>
        </div>
      </div>
      <p class="hint">Если Chrome запущен с отдельным <span class="key">--user-data-dir</span>, native messaging ищется внутри этого профиля. Обычная установка этого не требует.</p>
    </section>

    <section class="card">
      <div class="card-head">
        <h2>Firefox</h2>
        <span class="browser">Signed XPI</span>
      </div>
      <p class="sub">Обычно подписанный XPI уже установлен в профиль. Проверь <span class="key">about:addons</span> → Расширения.</p>

      <div class="step">
        <div class="num">1</div>
        <div>
          <b>Проверь about:addons</b>
          <p>Если <b>EXA Switch</b> уже в списке — перезапусти Firefox, если ещё не сделал этого.</p>
        </div>
      </div>
      <div class="step">
        <div class="num">2</div>
        <div>
          <b>Fallback для разработки: Load Temporary Add-on</b>
          <p>Введи <span class="key">about:debugging#/runtime/this-firefox</span> и выбери <span class="key">manifest.json</span> из папки:</p>
          <div class="pathline">
            <code class="path" id="firefoxPath">{{FIREFOX_DIR}}</code>
            <button class="copy" data-copy-target="firefoxPath">Копировать</button>
          </div>
        </div>
      </div>
      <div class="step">
        <div class="num">3</div>
        <div>
          <b>Помни про ограничение</b>
          <p>Temporary Add-on исчезает после перезапуска. Постоянная установка делается подписанным XPI автоматически.</p>
        </div>
      </div>
    </section>

    <section class="card wide">
      <div class="card-head">
        <h2>Что дальше</h2>
        <span class="browser">Quick start</span>
      </div>
      <div class="platform">
        <div class="mini">
          <div class="k">1. Профиль</div>
          <div class="v">Открой настройки расширения → вставь <b>vless://...</b> → «Импортировать»</div>
        </div>
        <div class="mini">
          <div class="k">2. Режим</div>
          <div class="v">Выбери <b>Авто</b> — прокси только для сайтов из правил</div>
        </div>
        <div class="mini">
          <div class="k">3. Правила</div>
          <div class="v">Открой сайт → popup → <b>Прокси</b>. Или добавь домены в «Правилах»</div>
        </div>
      </div>
      <p class="hint">Проверка: в настройках есть кнопка «Проверить» — она делает HTTPS-запрос через туннель и показывает задержку.</p>
    </section>

    <section class="card wide">
      <div class="card-head">
        <h2>Служебная информация</h2>
        <span class="browser">helper</span>
      </div>
      <div class="pathline">
        <code class="path" id="helperPath">{{HELPER}}</code>
        <button class="copy" data-copy-target="helperPath">Копировать</button>
      </div>
      <p class="hint">
        Данные: <span class="key">{{DATA_DIR}}</span><br>
        Статус: <span class="key">{{HELPER}} status</span> · остановить: <span class="key">{{HELPER}} stop</span><br>
        Сгенерировано: {{GENERATED_AT}} · Firefox ID: <span class="key">{{FIREFOX_ID}}</span>
      </p>
    </section>

  </div>

  <div class="footer">
    <div>EXA <span>//</span> EBANEX <span>//</span> SECURE TUNNEL</div>
    <div>VLESS · REALITY · XHTTP · v{{VERSION}}</div>
  </div>

</div>
<script>
(function () {
  function fallbackCopy(text) {
    var area = document.createElement("textarea");
    area.value = text;
    area.style.position = "fixed";
    area.style.opacity = "0";
    document.body.appendChild(area);
    area.select();
    try { document.execCommand("copy"); } catch (e) {}
    document.body.removeChild(area);
  }
  document.querySelectorAll(".copy").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var target = document.getElementById(btn.getAttribute("data-copy-target"));
      if (!target) return;
      var text = target.textContent;
      var done = function () {
        var old = btn.textContent;
        btn.textContent = "Скопировано";
        btn.classList.add("copy-ok");
        setTimeout(function () { btn.textContent = old; btn.classList.remove("copy-ok"); }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(function () { fallbackCopy(text); done(); });
      } else {
        fallbackCopy(text);
        done();
      }
    });
  });
})();
</script>
</body>
</html>
