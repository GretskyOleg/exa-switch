#!/usr/bin/env python3
"""Manage the EXA Switch CRX in Chromium-family browsers (per-user).

Usage:
  xray-switch-browsers list
  xray-switch-browsers install chrome,edge
  xray-switch-browsers install all
  xray-switch-browsers remove chrome
  xray-switch-browsers remove all

Firefox is managed by the package policy and is not changed by this tool.
"""
from __future__ import annotations

import base64
import hashlib
import json
import os
import pathlib
import sys

BROWSERS = {
    "chrome": ("Google Chrome", ["google-chrome", "google-chrome-beta"]),
    "chromium": ("Chromium", ["chromium"]),
    "edge": ("Microsoft Edge", ["microsoft-edge"]),
    "brave": ("Brave", ["BraveSoftware/Brave-Browser"]),
    "vivaldi": ("Vivaldi", ["vivaldi"]),
}
ALIASES = {
    "chrome": "chrome", "google-chrome": "chrome", "googlechrome": "chrome",
    "chromium": "chromium",
    "edge": "edge", "msedge": "edge", "microsoft-edge": "edge",
    "brave": "brave", "brave-browser": "brave",
    "vivaldi": "vivaldi",
}


def config_home() -> pathlib.Path:
    return pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or (pathlib.Path.home() / ".config"))


def app_root() -> pathlib.Path | None:
    candidates = [
        os.environ.get("XS_ROOT"),
        "/opt/xray-switch",
        pathlib.Path.home() / ".local/share/xray-switch",
    ]
    for candidate in candidates:
        if not candidate:
            continue
        root = pathlib.Path(candidate)
        if (root / "extension" / "chrome" / "manifest.json").is_file():
            return root
    return None


def crx_path() -> pathlib.Path | None:
    root = app_root()
    candidates = [
        pathlib.Path("/usr/share/xray-switch/exa-switch.crx"),
        root / "exa-switch.crx" if root else None,
        root / "exa-switch-chrome.crx" if root else None,
    ]
    for candidate in candidates:
        if candidate and pathlib.Path(candidate).is_file():
            return pathlib.Path(candidate)
    return None


def extension_info() -> tuple[str, str]:
    root = app_root()
    if not root:
        raise SystemExit("Не найден каталог EXA Switch (extension/chrome/manifest.json).")
    manifest = json.loads((root / "extension" / "chrome" / "manifest.json").read_text(encoding="utf-8"))
    key = manifest.get("key")
    if not key:
        raise SystemExit("В Chrome-манифесте нет публичного ключа.")
    der = base64.b64decode(key)
    digest = hashlib.sha256(der).digest()[:16]
    identifier = "".join(chr(97 + (b >> 4)) + chr(97 + (b & 0x0F)) for b in digest)
    return identifier, str(manifest.get("version") or "")


def roots_for(name: str) -> list[pathlib.Path]:
    base = config_home()
    return [base / rel for rel in BROWSERS[name][1]]


def detected(name: str) -> list[pathlib.Path]:
    return [root for root in roots_for(name) if root.is_dir()]


def json_path(root: pathlib.Path, identifier: str) -> pathlib.Path:
    return root / "External Extensions" / f"{identifier}.json"


def write_for(name: str, identifier: str, version: str, crx: pathlib.Path) -> int:
    count = 0
    for root in detected(name):
        target = json_path(root, identifier)
        target.parent.mkdir(parents=True, exist_ok=True)
        payload = {"external_crx": str(crx), "external_version": version}
        target.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
        print(f"  ✓ {BROWSERS[name][0]}: {target}")
        count += 1
    if not count:
        print(f"  - {BROWSERS[name][0]}: профиль не найден")
    return count


def remove_for(name: str, identifier: str) -> int:
    count = 0
    for root in roots_for(name):
        target = json_path(root, identifier)
        if target.exists():
            target.unlink()
            print(f"  ✓ {BROWSERS[name][0]}: удалено {target}")
            count += 1
    if not count:
        print(f"  - {BROWSERS[name][0]}: не установлено")
    return count


def parse_names(value: str) -> list[str]:
    lower = value.strip().lower()
    if lower in ("all", "*"):
        return list(BROWSERS)
    names = []
    for part in lower.replace(";", ",").replace(" ", ",").split(","):
        name = ALIASES.get(part.strip())
        if name and name not in names:
            names.append(name)
    return names


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    command = args[0].lower()
    identifier, version = extension_info()
    crx = crx_path()

    if command in ("list", "status"):
        print(f"Extension ID: {identifier}  version: {version}")
        print(f"CRX: {crx or 'не найден'}")
        print("Firefox: управляется policy пакета")
        for name in BROWSERS:
            roots = detected(name)
            state = "найден" if roots else "не найден"
            installed = any(json_path(root, identifier).exists() for root in roots)
            print(f"  {BROWSERS[name][0]:16} {state:10} external extension: {'да' if installed else 'нет'}")
            for root in roots:
                print(f"    {root}")
        return 0

    if command in ("install", "remove"):
        if len(args) < 2:
            raise SystemExit(f"Использование: xray-switch-browsers {command} <browser|all>")
        names = parse_names(args[1])
        if not names:
            raise SystemExit("Неизвестный браузер. Доступно: " + ", ".join(BROWSERS))
        print(("Устанавливаю" if command == "install" else "Удаляю") + " CRX:")
        if command == "install" and not crx:
            raise SystemExit("CRX не найден: /usr/share/xray-switch/exa-switch.crx")
        total = 0
        for name in names:
            total += (write_for(name, identifier, version, crx) if command == "install"
                      else remove_for(name, identifier))
        print(f"Готово: {total} профилей. Перезапустите браузер.")
        return 0

    raise SystemExit("Неизвестная команда. Смотрите --help.")


if __name__ == "__main__":
    raise SystemExit(main())
